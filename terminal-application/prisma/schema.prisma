// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  password_hash String?     // null -> Google-only account
  google_id     String?     @unique // null -> manual-only account
  created_at    DateTime    @default(now())

  // false at registration (manual OR Google, via the default) -> tour shows once.
  tutorial_completed Boolean @default(false)

  // Profile avatar as a small base64 data-URL (client resizes to ~192px JPEG
  // before upload, so this stays ~10-20KB). null -> initials fallback.
  avatar        String?

  watchlists    Watchlist[]
  setting       SystemSetting?
}

model Watchlist {
  id         String   @id @default(cuid())
  user_id    String
  asset_id   String
  asset_name String
  added_at   DateTime @default(now())
  
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, asset_id])
}

model CryptoAlert {
  id              String   @id @default(cuid())
  asset_id        String
  asset_name      String
  price_at_drop   Float
  drop_percentage Float
  detected_at     DateTime @default(now())

  @@index([asset_id, detected_at]) //it instantly finds alerts from the last 60 seconds.
  @@index([detected_at])// for finding the latest alerts
}

model SystemSetting {
  id              String @id @default(cuid())
  user_id         String @unique
  alert_threshold Float  @default(0.5)

  user            User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
}